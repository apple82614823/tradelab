# Public/private endpoint
BINANCE_BASE_URL=https://fapi.binance.com

# Keep true until you intentionally switch to real orders.
BINANCE_DRY_RUN=true
BINANCE_CONFIRM_LIVE_TRADING=

# Required only for private account checks and live trading.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Dry-run account simulation when no API key is configured.
DRY_RUN_BALANCE_USDT=1000

# Strategy parameters
POLL_INTERVAL_SECONDS=60
MULTI_STRATEGY_ENABLED=false
# Long positions receive funding when the funding rate is negative.
FUNDING_RATE_ABS_THRESHOLD=0.015
KLINE_INTERVAL=15m
KLINE_LIMIT=122
TREND_WINDOW=96

# Position sizing
DRY_RUN_MAX_LEVERAGE=50
DRY_RUN_TRADIFI_MAX_LEVERAGE=20
RISK_BALANCE_FRACTION=0.20
TAKE_PROFIT_R_MULTIPLE=5
STOP_LOSS_AMPLITUDE_RATIO=0.12
MIN_STOP_LOSS_PCT=0.01
MAX_STOP_LOSS_PCT=0.05
MAX_MARGIN_BALANCE_FRACTION=0.95
SYMBOL_COOLDOWN_HOURS=4

# Runtime files
STATE_FILE=state/position.json
DRY_RUN_ACCOUNT_FILE=state/dry_run_account.json
LOG_FILE=logs/trading.log
REVIEW_DB_FILE=data/trading_review.sqlite3
INSTANCE_LOCK_FILE=state/trading_bot.lock
